# Copy to .env (never commit .env). Validated at startup by src/lib/env.ts.

# Supabase Postgres — pooled (transaction pooler, port 6543) for the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres"
# Supabase Postgres — direct/session connection (port 5432) for Prisma migrations (prisma.config.ts)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."   # older projects: the "anon" key
SUPABASE_SECRET_KEY="sb_secret_..."                         # server only — used by deleteAccount

# Anthropic (Claude API)
ANTHROPIC_API_KEY="sk-ant-..."

# Stripe — test keys locally and on Vercel Preview; live keys (sk_live_) only on Vercel Production
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."                           # from `stripe listen` locally; live endpoint in Production
STRIPE_PRICE_PRO_MONTHLY_USD="price_..."                    # US$24/month
STRIPE_PRICE_PRO_QUARTERLY_USD="price_..."                  # US$59 every 90 days, charged up front
STRIPE_PRICE_PRO_MONTHLY_CAD="price_..."                    # CA$29/month
STRIPE_PRICE_PRO_QUARTERLY_CAD="price_..."                  # CA$75 every 90 days, charged up front
STRIPE_PRICE_PRO_MONTHLY="price_..."                        # legacy Price; checkout does not use it
STRIPE_PRICE_PRO_QUARTERLY="price_..."                      # legacy Price; checkout does not use it
STRIPE_COUPON_FOUNDING="..."                                # not applied at checkout; recognized only if an old subscription already used it

# Email (Resend). Commercial email includes a street address or PO box when this is a real address.
# The placeholder below is treated as unset and is not sent. A home address is not required.
RESEND_API_KEY="re_..."
EMAIL_FROM="RoleRefine <hello@mail.rolerefine.ca>"
MAILING_ADDRESS="Your mailing address, Ottawa, ON, Canada"

# Analytics (PostHog, cookieless)
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Bot protection (Cloudflare Turnstile) + IP hashing for free tools
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
TURNSTILE_SECRET_KEY="0x..."
IP_HASH_SALT="change-me-to-32+-random-characters"

# Scheduled jobs (Release 1.1)
CRON_SECRET="change-me"

# App. Production: https://www.rolerefine.ca. Vercel sets VERCEL_ENV (do not set it here).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev only — your Supabase user id. Used by prisma/seed.ts, npm run dev:scenario, and /dev.
# Must be unset on Vercel Production. Restart `npm run dev` after changing it.
SEED_USER_ID=""
